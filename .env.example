# Enable API authentication for production deployments.
CROWD_SECURITY_ENABLED=true
CROWD_AUTH_SECRET=replace-with-at-least-32-random-characters
CROWD_ADMIN_USERNAME=admin
CROWD_ADMIN_PASSWORD=change-this-password
# Optional: use a precomputed PBKDF2 hash instead of CROWD_ADMIN_PASSWORD.
# CROWD_ADMIN_PASSWORD_HASH=pbkdf2_sha256$210000$...
# PostgreSQL connection string (required for startup and tests).
# CROWD_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Optional JSON array of additional pre-hashed OPERATOR accounts:
# CROWD_USERS_JSON=[{"username":"operator","role":"OPERATOR","password_hash":"pbkdf2_sha256$210000$..."}]

