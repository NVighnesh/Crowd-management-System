# Local machine or GPU server running OpenCV/YOLO inference.
CROWD_RUNTIME_MODE=AI_WORKER
AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8100

# The worker uses the same database and private Storage bucket as the API.
CROWD_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CROWD_CORS_ORIGINS=http://localhost:5173
